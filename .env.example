# ================================================================
# LEADSCORPIO CRM & OUTBOUND OPERATIONS PLATFORM
# Environment Variables Specification
# ================================================================

# --- Supabase Configuration ---
# Public URL and Anonymous Key (Safe for browser / client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (CRITICAL: Server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Application Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="LeadScorpio CRM"

# --- Email Dual-Provider Architecture (Primary: Gmail SMTP, Fallback: Resend) ---
# Primary: Gmail SMTP (Sends from leadscorpioofficial@gmail.com with 0 domain restrictions)
SMTP_USER=leadscorpioofficial@gmail.com
SMTP_PASSWORD=

# Fallback: Resend API (Transactional delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=LeadScorpio
RESEND_REPLY_TO=leadscorpioofficial@gmail.com
RESEND_WEBHOOK_SECRET=

# --- AI Message Copilot (Optional - OpenAI or Gemini integration) ---
# Supported providers: openai, gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_DEMO_SEED=true

